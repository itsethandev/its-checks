{
  "name": "its-checks",
  "version": "0.1.0-beta.17",
  "private": true,
  "license": "MIT",
  "bin": {
    "its-checks": "bin/its-checks.js"
  },
  "files": [
    "bin",
    "src",
    "!src/modules/*/tests/**",
    "policy",
    "schemas"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run its-checks:check",
    "fmt": "bun run its-checks:fmt",
    "fmt:check": "bun run its-checks:fmt:check",
    "its-checks:check": "(\nnode --run fmt:check && node --run lint\n\n)",
    "its-checks:fmt": "(\noxfmt .\n\n)",
    "its-checks:fmt:check": "(\noxfmt --check .\n\n)",
    "its-checks:lint": "(\neffect-tsgo oxlint --deny-warnings .\n\n) && (\ndepcruise .\n\n)",
    "its-checks:lint:fix": "(\neffect-tsgo oxlint --fix --deny-warnings .\n\n) && (\ndepcruise .\n\n)",
    "lint": "bun run its-checks:lint",
    "lint:fix": "bun run its-checks:lint:fix",
    "test": "bun test ./src/modules/*/tests/*.test.ts ./test/*.test.ts",
    "test:cli": "python3 test/cli.pty.py",
    "test:managers": "bun test --timeout=120000 --max-concurrency=1 ./src/modules/application/tests/real-managers.integration.ts",
    "test:package": "bun test --timeout=120000 ./test/package.integration.ts",
    "test:policy": "bun test --timeout=180000 --max-concurrency=1 ./test/policy-compatibility.integration.ts",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "effect": "4.1.1",
    "jsonc-parser": "3.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/node": "24.19.2",
    "ajv": "8.17.1",
    "dependency-cruiser": "18.7.2",
    "husky": "9.1.7",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.2",
    "yarn": "1.22.22"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0"
}
