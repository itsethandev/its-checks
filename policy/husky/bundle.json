{
  "name": "Husky pre-commit",
  "description": "Check working-tree formatting and lint before commits; never fix or stage files",
  "scripts": {
    "postinstall": "husky",
    "check:precommit": "node --run fmt:check && node --run lint"
  },
  "devDependencies": {
    "husky": "9.1.7"
  },
  "requires": ["typescript"],
  "files": [
    {
      "source": "files/.husky/pre-commit",
      "target": ".husky/pre-commit",
      "operation": "replace",
      "executable": true
    }
  ]
}
