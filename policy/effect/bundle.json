{
  "name": "Effect",
  "description": "Typed failures, service requirements, and idiomatic Effect code",
  "devDependencies": {
    "@effect/tsgo": "0.63.0"
  },
  "scripts": {
    "lint": {
      "command": "effect-tsgo oxlint --deny-warnings .",
      "replaces": "typescript"
    },
    "lint:fix": {
      "command": "effect-tsgo oxlint --fix --deny-warnings .",
      "replaces": "typescript"
    }
  },
  "requires": ["typescript"],
  "files": [
    {
      "source": "files/.oxlintrc.json",
      "target": ".oxlintrc.json",
      "operation": "compose",
      "format": "json",
      "fields": {
        "/plugins": { "merge": "append-unique" },
        "/extends": { "merge": "append-unique" },
        "/$schema": { "replaces": "typescript" },
        "/rules/unicorn~1throw-new-error": { "replaces": "typescript" },
        "/rules/no-underscore-dangle/1/allow": { "merge": "append-unique" }
      }
    }
  ]
}
