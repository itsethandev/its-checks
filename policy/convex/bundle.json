{
  "name": "Convex",
  "description": "Access control, bounded queries, and Convex best practices",
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.1"
  },
  "requires": ["typescript"],
  "files": [
    {
      "source": "files/.oxlintrc.json",
      "target": ".oxlintrc.json",
      "operation": "compose",
      "format": "json",
      "fields": {
        "/jsPlugins": { "merge": "append-unique" },
        "/overrides": { "merge": "append-unique" },
        "/ignorePatterns": { "merge": "append-unique" },
        "/rules/no-underscore-dangle/1/allow": { "merge": "append-unique" }
      }
    }
  ]
}
